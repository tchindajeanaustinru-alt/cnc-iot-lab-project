    {
        "id": "4b4468583c668617",
        "type": "function",
        "z": "47754dbdd9d8b9c5",
        "name": "Parse CNC Data",
        "func": "let result = {};\n\n// A recursive function to find all key-value pairs\nfunction extract(data) {\n    if (!Array.isArray(data)) return;\n\n    for (let i = 0; i < data.length; i++) {\n        let item = data[i];\n\n        if (Array.isArray(item)) {\n            // If it's a key-value pair (e.g., [\"Key\", \"Value\"])\n            if (item.length === 2 && typeof item[0] === 'string' && typeof item[1] === 'string') {\n                let key = item[0];\n                let value = item[1];\n\n                // Extract exactly what we need based on the Russian names\n                if (key === \"Время работы ядра (всего)\") result.core_uptime_total = value;\n                if (key === \"Время работы ядра (текущее)\") result.core_uptime_current = value;\n                if (key === \"Время работы канала (всего)\") result.channel_uptime_total = value;\n                if (key === \"Статус канала\") result.channel_status = value;\n                if (key === \"Режим канала\") result.channel_mode = value;\n                if (key === \"Время работы программы\") result.program_uptime = value;\n                if (key === \"Процент выполнения программы\") result.program_percent = value;\n                if (key === \"Программа\") result.program_name = value;\n                if (key === \"Ошибка\") result.error = value;\n\n                // Extract axes movements\n                if (key === \"Перемещение по оси X\") result.axis_x = value;\n                if (key === \"Перемещение по оси Y\") result.axis_y = value;\n                if (key === \"Перемещение по оси Z\") result.axis_z = value;\n\n            } else {\n                // If it's a nested array, dig deeper\n                extract(item);\n            }\n        }\n    }\n}\n\n// Start extracting from the parsed JSON payload\nextract(msg.payload.data);\n\n// Add a timestamp for the database\nresult.timestamp = new Date().toISOString();\n\n// Send the clean data forward\nmsg.payload = result;\nreturn msg;",
