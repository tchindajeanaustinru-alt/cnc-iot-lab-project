    {
        "id": "21e9638a88d97126",
        "type": "function",
        "z": "47754dbdd9d8b9c5",
        "name": "Combine and Prepare MQTT",
        "func": "// Use Node-RED context to store the last received values\nlet temp = context.get('temp') || \"0\";\nlet hump = context.get('hump') || \"0\";\n\n// Check which topic triggered this function\nif (msg.topic === 'demodata/temp') {\n    temp = msg.payload;\n    context.set('temp', temp);\n} else if (msg.topic === 'demodata/hump') {\n    hump = msg.payload;\n    context.set('hump', hump);\n}\n\n// Create the timestamp\nlet now = new Date();\nlet mysqlTimestamp = now.toISOString().slice(0, 19).replace('T', ' ');\n\n// Construct the SQL query\nmsg.topic = `INSERT INTO mqtt_data (timestamp, temperature, humidity) VALUES ('${mysqlTimestamp}', '${temp}', '${hump}')`;\nreturn msg;",
        "outputs": 1,
