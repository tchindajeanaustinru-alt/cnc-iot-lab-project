    {
        "id": "807a6799c02a47ee",
        "type": "function",
        "z": "47754dbdd9d8b9c5",
        "name": "Prepare SQL",
        "func": "// Extract the data from the parsed payload\nlet d = msg.payload;\n\n// Format the timestamp for MySQL (YYYY-MM-DD HH:MM:SS)\nlet now = new Date();\nlet mysqlTimestamp = now.toISOString().slice(0, 19).replace('T', ' ');\n\n// Construct the SQL INSERT query using template literals\n// We use ISNULL to handle empty values\nlet query = `INSERT INTO cnc_data (\n    timestamp, \n    core_uptime_total, \n    core_uptime_current, \n    channel_uptime_total, \n    channel_status, \n    channel_mode, \n    program_uptime, \n    program_percent, \n    program_name, \n    error, \n    axis_x, \n    axis_y, \n    axis_z\n) VALUES (\n    '${mysqlTimestamp}', \n    '${d.core_uptime_total || ''}', \n    '${d.core_uptime_current || ''}', \n    '${d.channel_uptime_total || ''}', \n    '${d.channel_status || ''}', \n    '${d.channel_mode || ''}', \n    '${d.program_uptime || ''}', \n    '${d.program_percent || ''}', \n    '${d.program_name || ''}', \n    '${d.error || ''}', \n    '${d.axis_x || ''}', \n    '${d.axis_y || ''}', \n    '${d.axis_z || ''}'\n)`;\n\n// Send the query to the MySQL node\nmsg.topic = query;\nreturn msg;",
